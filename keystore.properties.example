# Copy this file to keystore.properties and replace every placeholder.
# Do not commit keystore.properties or the keystore file itself.
# You can also provide the same values via these environment variables:
# BRAINCLEAN_RELEASE_STORE_FILE
# BRAINCLEAN_RELEASE_STORE_PASSWORD
# BRAINCLEAN_RELEASE_KEY_ALIAS
# BRAINCLEAN_RELEASE_KEY_PASSWORD

# Relative path from the project root, or an absolute path if you prefer.
# Recommended local path:
# release-keystore/brainclean-upload.jks
release.storeFile=release-keystore/brainclean-upload.jks

# Password that protects the keystore file.
release.storePassword=CHANGE_ME

# Alias of the signing key inside the keystore.
release.keyAlias=upload

# Password for the alias above.
release.keyPassword=CHANGE_ME
